{
  "name": "site-tracker",
  "version": "1.0.0",
  "description": "REST API for tracking telecom sites, their equipment and inspections (Express, TypeORM, PostgreSQL)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "migration:run": "typeorm migration:run -d src/data-source.js",
    "migration:revert": "typeorm migration:revert -d src/data-source.js",
    "migration:generate": "typeorm migration:generate -d src/data-source.js -o",
    "seed": "node src/seed.js",
    "test:api": "newman run ../postman/site-tracker.postman_collection.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "newman": "^6.2.3",
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=20.19"
  }
}
